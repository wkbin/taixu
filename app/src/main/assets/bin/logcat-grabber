#!/bin/sh
# TaiXu Logcat Grabber — 优先通过宿主桥接 (无线 ADB / Shizuku) 抓取应用日志
set -eu

show_help() {
    cat << 'HELP'
Logcat Grabber — 应用日志抓取工具（内置无线 ADB 优先，自动 mDNS 发现）

用法:
  logcat-grabber <包名> [选项]

选项:
  -t, --tag TAG         按 Tag 过滤
  -p, --priority LEVEL  按优先级过滤 (V/D/I/W/E/F)
  -k, --keyword KW      按关键词过滤
  -n, --lines N         行数 (默认 200)
  -P, --port PORT       指定无线调试端口 (默认自动发现)
  --clear               先清空 logcat 缓冲区
  -o, --output FILE     输出到文件
  -h, --help            显示帮助
HELP
}

PACKAGE=""
TAG=""
PRIORITY="V"
KEYWORD=""
LINES=200
PORT=""
CLEAR=false
OUTPUT=""

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        -t|--tag) TAG="$2"; shift 2 ;;
        -p|--priority) PRIORITY="$2"; shift 2 ;;
        -k|--keyword) KEYWORD="$2"; shift 2 ;;
        -n|--lines) LINES="$2"; shift 2 ;;
        -P|--port) PORT="$2"; shift 2 ;;
        --clear) CLEAR=true; shift ;;
        -o|--output) OUTPUT="$2"; shift 2 ;;
        *)
            if [ -z "$PACKAGE" ]; then
                PACKAGE="$1"
            fi
            shift ;;
    esac
done

BRIDGE_URL="http://127.0.0.1:7980"
KEY_FILE="/opt/taixu/.bridge-key"
AUTH=""
if [ -f "$KEY_FILE" ]; then
    AUTH="Authorization: Bearer $(cat "$KEY_FILE" 2>/dev/null | tr -d '[:space:]')"
fi

if [ "$CLEAR" = "true" ]; then
    curl -s -X POST "$BRIDGE_URL/api/logcat" -H 'Content-Type: application/json' ${AUTH:+-H "$AUTH"} -d '{"clear":true}' >/dev/null 2>&1 || true
fi

if [ -n "$PORT" ]; then
    BODY=$(printf '{"package":"%s","tag":"%s","priority":"%s","keyword":"%s","lines":%s,"port":%s}' "$PACKAGE" "$TAG" "$PRIORITY" "$KEYWORD" "$LINES" "$PORT")
else
    BODY=$(printf '{"package":"%s","tag":"%s","priority":"%s","keyword":"%s","lines":%s}' "$PACKAGE" "$TAG" "$PRIORITY" "$KEYWORD" "$LINES")
fi

if [ -n "$OUTPUT" ]; then
    mkdir -p "$(dirname "$OUTPUT")" 2>/dev/null || true
    RESPONSE=$(curl -s -X POST "$BRIDGE_URL/api/logcat" -H 'Content-Type: application/json' ${AUTH:+-H "$AUTH"} -d "$BODY")
    if command -v jq >/dev/null 2>&1; then
        echo "$RESPONSE" | jq -r '.output // .error // empty' > "$OUTPUT"
    else
        echo "$RESPONSE" > "$OUTPUT"
    fi
    echo "日志已保存到 $OUTPUT"
else
    RESPONSE=$(curl -s -X POST "$BRIDGE_URL/api/logcat" -H 'Content-Type: application/json' ${AUTH:+-H "$AUTH"} -d "$BODY")
    if command -v jq >/dev/null 2>&1; then
        echo "$RESPONSE" | jq -r '.output // .error // empty'
    else
        echo "$RESPONSE"
    fi
fi